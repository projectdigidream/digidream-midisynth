      "noiseColor": "white",
      "mixGain": 0.3,
      "ampEnv": {
       "attack": 0,
       "decay": 26,
       "sustain": 0,
       "release": 0,
       "decayCurve": "exp"
      },
      "filter": {
       "mode": "bandpass",
       "cutoffHz": 2400,
       "resonance": 0.7
      }
     }
    ]
   },
   "38": {
    "name": "dnb_snare",
    "oneShot": true,
    "_about": "Velocity does the ghosting: soft hits lose the body and darken the noise.",
    "layers": [
     {
      "_about": "Shell: the drum itself, and on a real snare this is most of the sound. Lowpassed, not bandpassed at 1.9 kHz where the tone does not reach.",
      "pitchNote": 55,
      "mixGain": 0.8,
      "velCurve": "soft",
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 1,
       "params": {
        "startHarmonics": 3,
        "endHarmonics": 3,
        "falloff": "saw"
       }
      },
      "ampEnv": {
       "attack": 0,
       "decay": 135,
       "sustain": 0,
       "release": 0,
       "decayCurve": "exp"
      },
      "pitchEnv": {
       "attack": 0,
       "decay": 28,
       "sustain": 0,
       "release": 0,
       "depthSemis": 5
      },
      "filter": {
       "mode": "lowpass",
       "cutoffHz": 820,
       "resonance": 0.25,
       "drive": 1.7
      },
      "modMatrix": [
       {
        "src": "Velocity",
        "dst": "Amplitude",
        "amount": 0.35
       }
      ]
     },
     {
      "_about": "Wires: the buzz. Band-limited on both sides so it reads as snares, not as white hiss.",
      "osc": "noise",
      "noiseColor": "pink",
      "mixGain": 0.7,
      "velCurve": "soft",
      "ampEnv": {
       "attack": 0,
       "decay": 175,
       "sustain": 0,
       "release": 0,
