 "bank": {
  "version": 1,
  "_about": "Dreamy/liquid drum & bass voices, synthesised only -- no samples anywhere. Program numbers keep their GM meaning so a track's instrument picker still reads sensibly.",
  "programs": {
   "4": {
    "name": "dnb_rhodes",
    "_about": "FM electric piano. The index is deliberately modest: a Rhodes is a tine, not a bell, and a high index puts a nasal 1-3 kHz buzz over everything. The envelope still moves it, just over a smaller range.",
    "layers": [
     {
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 1,
       "params": {
        "startHarmonics": 1,
        "endHarmonics": 1,
        "falloff": "flat"
       }
      },
      "mixGain": 0.5,
      "ring": {
       "mode": "fm",
       "ratio": 2,
       "index": 0.18
      },
      "ampEnv": {
       "attack": 3,
       "decay": 2600,
       "sustain": 0.22,
       "release": 700,
       "decayCurve": "exp"
      },
      "filterEnv": {
       "attack": 0,
       "decay": 900,
       "sustain": 0.05,
       "release": 300
      },
      "filter": {
       "mode": "lowpass",
       "cutoffHz": 3200,
       "slope": 12
      },
      "sendReverb": 0.28,
      "sendDelay": 0.3,
      "modMatrix": [
       {
        "src": "FilterEnv",
        "dst": "RingAmount",
        "amount": 0.1
       },
       {
        "src": "Velocity",
        "dst": "RingAmount",
        "amount": 0.06
       },
       {
        "src": "Velocity",
        "dst": "FilterCutoff",
        "amount": 0.18
       }
      ]
     },
     {
      "_about": "The tine: a short high FM ping on top of the attack.",
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 1,
       "params": {
        "startHarmonics": 1,
        "endHarmonics": 1,
        "falloff": "flat"
       }
      },
      "detuneCents": 1200,
      "mixGain": 0.07,
      "velCurve": "linear",
      "ring": {
       "mode": "fm",
       "ratio": 4,
       "index": 0.4
      },
      "ampEnv": {
       "attack": 0,
       "decay": 170,
       "sustain": 0,
       "release": 100,
       "decayCurve": "exp"
      },
      "filter": {
       "mode": "bandpass",
       "cutoffHz": 1500,
       "resonance": 0.2
      },
      "sendReverb": 0.3
     }
    ]
   },
   "38": {
    "name": "dnb_reese",
    "_about": "The Reese: detuned saws, phase-spread so the stack beats from the first sample, through a notch that a slow bar-synced LFO walks. Free-running LFOs, so a held note keeps moving instead of restarting.",
    "layers": [
     {
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 1,
       "params": {
        "startHarmonics": 24,
        "endHarmonics": 24,
        "falloff": "saw"
       }
      },
      "mixGain": 0.42,
      "unison": {
       "voices": 5,
       "detuneCents": 19,
       "spread": 0.65,
       "phaseSpread": 1
      },
      "ampEnv": {
       "attack": 8,
       "decay": 0,
       "sustain": 1,
       "release": 140
      },
      "filter": {
       "mode": "lowpass",
       "cutoffHz": 780,
       "resonance": 0.28,
       "drive": 1.8
      },
      "filter2": {
       "mode": "notch",
       "cutoffHz": 420,
       "resonance": 0.6
      },
      "filterRouting": "serial",
      "postDrive": 1.5,
      "keyTrackFilter": 0.35,
      "lfos": [
       {
        "shape": "sine",
        "sync": "1/1",
        "retrigger": false
       },
       {
        "shape": "triangle",
        "sync": "2/1",
        "retrigger": false
       }
      ],
      "modMatrix": [
       {
        "src": "LFO1",
        "dst": "FilterCutoff",
        "amount": 0.22
       },
       {
        "src": "LFO2",
        "dst": "PostDrive",
        "amount": 0.12
       },
       {
        "src": "Velocity",
        "dst": "FilterCutoff",
        "amount": 0.18
       },
       {
        "src": "ModWheel",
        "dst": "FilterCutoff",
        "amount": 0.3
       }
      ]
     },
     {
      "_about": "Sub underneath, so the Reese can be filtered hard without losing weight.",
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 1,
       "params": {
        "startHarmonics": 1,
        "endHarmonics": 1,
        "falloff": "flat"
       }
      },
      "detuneCents": -1200,
      "mixGain": 0.55,
      "ampEnv": {
       "attack": 8,
       "decay": 0,
       "sustain": 1,
       "release": 120
      },
      "filter": {
       "mode": "lowpass",
       "cutoffHz": 200,
       "slope": 24
      }
     }
    ]
   },
   "39": {
    "name": "dnb_sub",
    "_about": "Clean sine sub. Deliberately plain: no unison, no detune, nothing that would smear the low end. Play it mono, below C2.",
    "layers": [
     {
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 1,
       "params": {
        "startHarmonics": 1,
        "endHarmonics": 1,
        "falloff": "flat"
       }
      },
      "mixGain": 0.85,
      "ampEnv": {
       "attack": 6,
       "decay": 0,
       "sustain": 1,
       "release": 90,
       "releaseCurve": "exp"
      },
      "filter": {
       "mode": "lowpass",
       "cutoffHz": 220,
       "resonance": 0.05,
       "slope": 24,
       "drive": 1.4
      },
      "modMatrix": [
       {
        "src": "Velocity",
        "dst": "Amplitude",
        "amount": 0.15
       }
      ]
     },
     {
      "_about": "A whisper of second harmonic so the note is audible on a phone speaker.",
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 1,
       "params": {
        "startHarmonics": 2,
        "endHarmonics": 2,
        "falloff": "saw"
       }
      },
      "detuneCents": 1200,
      "mixGain": 0.1,
      "ampEnv": {
       "attack": 6,
       "decay": 400,
       "sustain": 0.3,
       "release": 90
      },
      "filter": {
       "mode": "lowpass",
       "cutoffHz": 1200
      }
     }
    ]
   },
   "81": {
    "name": "dnb_pluck",
    "_about": "Short filtered pluck for the dotted-eighth delay to catch. Keep the note short; the echo does the rest.",
    "layers": [
     {
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 1,
       "params": {
