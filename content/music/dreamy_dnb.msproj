       "release": 200,
       "depth": 0.65
      },
      "keyTrackFilter": 0.5,
      "sendDelay": 0.7,
      "sendReverb": 0.25,
      "modMatrix": [
       {
        "src": "Velocity",
        "dst": "FilterCutoff",
        "amount": 0.3
       }
      ]
     }
    ]
   },
   "89": {
    "name": "dnb_liquid_pad",
    "_about": "The dreamy half. Slow swell, free-running LFOs on cutoff and pan so it drifts, a breath of pink noise for air, and most of it sent to reverb.",
    "layers": [
     {
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 8,
       "params": {
