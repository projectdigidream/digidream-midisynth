 "kit": {
  "version": 1,
  "_about": "A synthesised break kit for ~174 BPM. No samples: the snare is a tuned body plus pink noise, the cymbals are the inharmonic metal oscillator, and ghost notes come from velocity rather than from separate sounds -- play 38 softly and it thins out by itself.",
  "notes": {
   "36": {
    "name": "dnb_kick",
    "oneShot": true,
    "layers": [
     {
      "_about": "Body: a sine dropped fast from a high start. Short, so it never fights the sub.",
      "pitchNote": 33,
      "mixGain": 0.72,
      "wavetable": {
       "generator": "additiveHarmonicMorph",
       "frameCount": 1,
       "params": {
        "startHarmonics": 1,
        "endHarmonics": 1,
        "falloff": "flat"
       }
      },
      "ampEnv": {
       "attack": 0,
       "decay": 200,
       "sustain": 0,
       "release": 0,
       "decayCurve": "exp"
      },
      "pitchEnv": {
       "attack": 0,
       "decay": 26,
       "sustain": 0,
       "release": 0,
       "depthSemis": 30
      },
      "filter": {
       "mode": "lowpass",
       "cutoffHz": 1400,
       "drive": 2.4
      }
     },
     {
      "_about": "Beater click so it reads on small speakers.",
      "osc": "noise",
      "noiseColor": "white",
      "mixGain": 0.18,
      "ampEnv": {
       "attack": 0,
       "decay": 12,
       "sustain": 0,
       "release": 0,
       "decayCurve": "exp"
      },
      "filter": {
       "mode": "bandpass",
       "cutoffHz": 2600,
       "resonance": 0.3
      }
     }
    ]
   },
